#include <stdio.h>
#include <stdlib.h>

int x[20], n;
int solutions_count = 0;

int place(int k, int i) {
    for (int j = 1; j < k; j++) {
        // Check if a queen is already in column 'i' OR on the same diagonal
        if (x[j] == i || abs(x[j] - i) == abs(j - k)) {
            return 0; // Invalid position
        }
    }
    return 1; // Valid position
}

void nqueen(int k) {
    for (int i = 1; i <= n; i++) {
        if (place(k, i)) {
            x[k] = i; // Place the queen in row k, column i
            if (k == n) {
                // Solution found, print the board configuration
                solutions_count++;
                printf("Solution %d: ", solutions_count);
                for (int j = 1; j <= n; j++) {
                    printf("%d ", x[j]);
                }
                printf("\n");
            } else {
                nqueen(k + 1); // Move to the next queen
            }
        }
    }
}

int main() {
    printf("Enter n: ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 20) {
        printf("Invalid input! Please enter a number between 1 and 20.\n");
        return 1;
    }

    nqueen(1);

    if (solutions_count == 0) {
        printf("No solutions found for N = %d\n", n);
    } else {
        printf("Total solutions found: %d\n", solutions_count);
    }

    return 0;
}
