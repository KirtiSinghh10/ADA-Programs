#include <stdio.h>
#include <stdlib.h>

// Structure to represent an item
typedef struct {
    int value, weight;
    double ratio;
} Item;

// Comparator to sort items by ratio descending
int compare(const void *a, const void *b) {
    double r1 = ((Item *)a)->ratio;
    double r2 = ((Item *)b)->ratio;
    if (r2 > r1) return 1;
    if (r2 < r1) return -1;
    return 0;
}

double fractionalKnapsack(Item items[], int n, int capacity) {
    // 1. Calculate ratio and sort
    for (int i = 0; i < n; i++) items[i].ratio = (double)items[i].value / items[i].weight;
    qsort(items, n, sizeof(Item), compare);

    int currentWeight = 0;
    double totalValue = 0.0;
    
    // 2. Greedy selection
    for (int i = 0; i < n; i++) {
        if (currentWeight + items[i].weight <= capacity) {
            currentWeight += items[i].weight;
            totalValue += items[i].value;
        } else {
            // Take fraction
            totalValue += items[i].value * ((double)(capacity - currentWeight) / items[i].weight);
            break;
        }
    }
    return totalValue;
}

int main() {
    Item items[] = {{60, 10}, {100, 20}, {120, 30}};
    printf("Max value: %.2f\n", fractionalKnapsack(items, 3, 50));
    return 0;
}
